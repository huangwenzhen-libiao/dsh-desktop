<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DSHarness</AssemblyName>
    <RootNamespace>DSHarness.Desktop</RootNamespace>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>DSH Desktop</Product>
    <Description>本地 DeepSeek Harness 桌面窗口</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
